# ============================================================
# 云购生活 · 一键部署环境变量模板
# 使用方法：
#   1. 复制为 .env：  copy .env.example .env
#   2. 修改所有 change_me 值（务必使用强密码）
#   3. .env 不要提交 Git（已在 .gitignore 中排除）
# 生成强随机值：
#   python -c "import secrets;print(secrets.token_urlsafe(32))"
# ============================================================

# ---------- MySQL（Hive Metastore + Superset 元数据库） ----------
MYSQL_ROOT_PASSWORD=change_me_mysql_root

# ---------- Superset ----------
# Flask 会话签名密钥，泄露会导致会话伪造，必须为随机长字符串
SUPERSET_SECRET_KEY=change_me_superset_secret_key
SUPERSET_ADMIN_PASSWORD=change_me_admin_password

# ---------- ClickHouse ----------
CLICKHOUSE_PASSWORD=change_me_clickhouse_password

# ---------- 大模型 API（Streamlit NL2SQL） ----------
# 留空则应用自动进入演示模式
DEEPSEEK_API_KEY=sk-your-deepseek-api-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
