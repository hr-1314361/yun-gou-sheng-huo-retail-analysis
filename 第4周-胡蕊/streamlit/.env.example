# ============================================================
# Streamlit 智能问数 · 环境变量模板
# 使用方法：复制为 .env 并填写真实值（.env 已在 .gitignore 中排除）
# ============================================================

# 大模型（DeepSeek，OpenAI 兼容接口）
DEEPSEEK_API_KEY=sk-your-deepseek-api-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# Hive 连接（容器内部署时主机名为 hive-server2）
HIVE_HOST=localhost
HIVE_PORT=10000
HIVE_USER=hive
